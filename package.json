{
  "name": "music-video-history-archives",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "verify:canon": "node scripts/validate-canon-research-batches.mjs && node scripts/validate-canon-evidence.mjs && node scripts/validate-canon-coverage.mjs",
    "report:canon": "node scripts/summarize-canon-evidence.mjs",
    "verify:pilot": "node --env-file=.env.local scripts/verify-pilot.mjs",
    "verify:canon:live": "node --env-file=.env.local scripts/verify-canon-publication.mjs && node --env-file=.env.local scripts/verify-canon-hold-release.mjs",
    "verify:thumbnails": "node --env-file=.env.local scripts/verify-thumbnails.mjs",
    "verify:knowledge-graph": "node --env-file=.env.local scripts/validate-knowledge-graph.mjs",
    "report:knowledge-scope": "node --env-file=.env.local scripts/export-published-knowledge-scope.mjs",
    "generate:knowledge-sprint-2": "node scripts/generate-published-knowledge-graph-sprint-2.mjs",
    "verify:knowledge-sprint-2": "node --env-file=.env.local scripts/validate-published-knowledge-graph.mjs",
    "verify:work-addition": "node --env-file=.env.local scripts/validate-work-addition.mjs docs/research/work-additions/kylie-minogue-come-into-my-world.json",
    "verify:work-additions": "node --env-file=.env.local scripts/validate-work-addition.mjs docs/research/work-additions/nirvana-smells-like-teen-spirit.json && node --env-file=.env.local scripts/validate-work-addition.mjs docs/research/work-additions/ok-go-here-it-goes-again.json",
    "verify:adventures-in-success": "node --env-file=.env.local scripts/validate-work-addition.mjs docs/research/work-additions/will-powers-adventures-in-success.json"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
