NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Supabase is the primary source of truth after the pilot publication.
MVHL_DATA_SOURCE=supabase

# Emergency-only fallback. Leave false in public deployments so unpublished
# JSON candidates can never appear after a Supabase outage.
MVHL_JSON_FALLBACK=false
