    {
      "artist": "Flying Lotus",
      "title": "Never Catch Me",
      "metadata": {
        "officialTitle": "Never Catch Me",
        "releaseYear": 2014,
        "countryCode": "US",
        "directors": ["Hiro Murai"],
        "productionCompany": "Doomsday Entertainment",
        "vfxProduction": null,
        "label": "Warp Records",
        "youtubeUrl": "https://www.youtube.com/watch?v=2lXD0vv-ds8",
        "youtubeId": "2lXD0vv-ds8",
        "thumbnailUrl": "https://i.ytimg.com/vi/2lXD0vv-ds8/maxresdefault.jpg",
        "runtimeSeconds": null,
        "genre": "Electronic Hip-Hop"
      },
      "editorial": {
        "en": {
          "shortSummary": "Two children rise from their coffins during a funeral and dance out of the church, through the streets, and away from the mourning adults who cannot see them.",
          "whyItMatters": "The video uses dance to hold grief and release in the same image, allowing choreography to function as narrative action rather than illustration.",
          "historicalContext": "Directed by Hiro Murai and released in 2014 during Flying Lotus's You're Dead! period, the film won Best Alternative Video — International at the 2015 UK Music Video Awards.",
          "keyInnovation": "A continuous progression from ritual stillness to expansive movement lets two young performers carry the film's emotional shift without explanatory dialogue or visual effects."
        },
        "ja": {
          "shortSummary": "葬儀の最中に二人の子どもが棺から起き上がり、大人たちには見えないまま教会を出て、街を踊りながら去っていく作品。",
          "whyItMatters": "悲嘆と解放を同じ画面に置き、振付を楽曲の説明ではなく物語を進める行為として機能させました。",
          "historicalContext": "Hiro Muraiが監督し、Flying Lotusの『You're Dead!』期である2014年に公開。2015年UK Music Video AwardsでBest Alternative Video — Internationalを受賞しました。",
          "keyInnovation": "儀式的な静止から広がりのある動きへ連続的に移行し、説明的な台詞やVFXに頼らず、二人の若い演者が作品の感情変化を担います。"
        }
      },
      "sources": [
