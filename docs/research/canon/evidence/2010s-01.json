    {
      "artist": "Sia",
      "title": "Chandelier",
      "metadata": {
        "officialTitle": "Chandelier",
        "releaseYear": 2014,
        "countryCode": "US",
        "directors": ["Sia", "Daniel Askill"],
        "productionCompany": null,
        "vfxProduction": null,
        "label": "RCA Records",
        "youtubeUrl": "https://www.youtube.com/watch?v=2vjPBrBU-TM",
        "youtubeId": "2vjPBrBU-TM",
        "thumbnailUrl": "https://i.ytimg.com/vi/2vjPBrBU-TM/maxresdefault.jpg",
        "runtimeSeconds": null,
        "genre": "Pop"
      },
      "editorial": {
        "en": {
          "shortSummary": "Maddie Ziegler performs a sustained solo inside a neglected apartment, moving between play, compulsion, exhaustion, and confrontation.",
          "whyItMatters": "The video places a single dancer at the center of a pop release and allows choreography, rather than the singer's physical presence, to define the work's public image.",
          "historicalContext": "Directed by Sia and Daniel Askill and released in 2014, the video won Best Pop Video — International at the UKMVAs, received two D&AD Pencils, and was nominated for the 2015 GRAMMY for Best Music Video.",
          "keyInnovation": "A bounded domestic set, close camera proximity, elastic full-body choreography, and an uninterrupted performance identity turn movement into the video's complete narrative vocabulary."
        },
        "ja": {
          "shortSummary": "Maddie Zieglerが荒れた室内で持続的なソロを演じ、遊び、衝動、疲労、対峙のあいだを身体で移動する作品。",
          "whyItMatters": "一人のダンサーをポップ作品の中心に置き、歌手本人の身体的な登場ではなく、振付によって作品の公共的イメージを定義しました。",
          "historicalContext": "SiaとDaniel Askillが監督し2014年に公開。UKMVAのBest Pop Video — International、D&ADの2本のPencilを獲得し、2015年GRAMMY Best Music Videoにノミネートされました。",
          "keyInnovation": "境界のある室内セット、近接するカメラ、伸縮性の高い全身振付、一貫した演技上の人格によって、動きそのものを映像の完全な物語語彙にしています。"
        }
      },
