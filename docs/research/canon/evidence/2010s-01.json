    {
      "artist": "Pharrell Williams",
      "title": "Happy",
      "metadata": {
        "officialTitle": "Happy",
        "releaseYear": 2013,
        "countryCode": "FR",
        "directors": ["We Are From LA"],
        "productionCompany": null,
        "vfxProduction": null,
        "label": null,
        "youtubeUrl": "https://www.youtube.com/watch?v=ZbZSe6N_BXs",
        "youtubeId": "ZbZSe6N_BXs",
        "thumbnailUrl": "https://i.ytimg.com/vi/ZbZSe6N_BXs/maxresdefault.jpg",
        "runtimeSeconds": null,
        "genre": "Pop"
      },
      "editorial": {
        "en": {
          "shortSummary": "Hundreds of performers move through Los Angeles in repeating single-take segments arranged across a continuous twenty-four-hour interactive timeline.",
          "whyItMatters": "The project expanded a music video from a fixed short film into a day-long navigable structure, while keeping each segment legible as a direct encounter between one performer, one place, and one song.",
          "historicalContext": "Directed by We Are From LA and released in 2013, the 24-hour project received three D&AD Pencils in 2014 and the 2015 GRAMMY for Best Music Video.",
          "keyInnovation": "A clock-based interface, looping song structure, repeated tracking shots, location continuity, and a large cast make duration itself the organizing principle of the work."
        },
        "ja": {
          "shortSummary": "数百人の演者がロサンゼルスを移動するワンテイクの断片を、連続する24時間のインタラクティブな時間軸へ配置した作品。",
          "whyItMatters": "MVを固定された短編から一日分の閲覧可能な構造へ拡張しながら、各断片を、一人の演者、一つの場所、一つの楽曲による直接的な出会いとして保ちました。",
          "historicalContext": "We Are From LAが監督し2013年に公開。24時間版は2014年D&ADで3本のPencilを獲得し、2015年GRAMMY Best Music Videoを受賞しました。",
          "keyInnovation": "時計に基づくインターフェース、ループする楽曲構造、反復する追跡撮影、場所の連続性、大規模な出演者によって、継続時間そのものを作品の構成原理にしています。"
        }
      },
