      "artist": "millennium parade",
      "title": "Fly with me",
      "metadata": {
        "officialTitle": "Fly with me",
        "releaseYear": 2020,
        "countryCode": "JP",
        "directors": [
          "Shu Sasaki",
          "Yuhei Kanbe",
          "PERIMETRON"
        ],
        "productionCompany": "PERIMETRON",
        "vfxProduction": "OPTICAL FORCE, inc. / N-DESIGN Inc. / NEWPOT PICTURES Inc. / DIGITAL GARDEN Inc. / SAZABI Inc.",
        "label": null,
        "youtubeUrl": "https://www.youtube.com/watch?v=fuXZMQAD9vU",
        "youtubeId": "fuXZMQAD9vU",
        "thumbnailUrl": "https://i.ytimg.com/vi/fuXZMQAD9vU/sddefault.jpg",
        "runtimeSeconds": null,
        "genre": "Alternative / 3DCG Animation"
      },
      "editorial": {
        "en": {
          "shortSummary": "A dense 3DCG city, airborne vehicles, masked figures, interface graphics, and motion-captured performance form a continuous cyberpunk pursuit.",
          "whyItMatters": "The work demonstrates how a Japanese creative collective can coordinate animation, CG, graphic design, compositing, and performance capture as one authorship system.",
          "historicalContext": "Released in 2020 in connection with Ghost in the Shell: SAC_2045, the video was directed within PERIMETRON by Shu Sasaki and Yuhei Kanbe with a large distributed production team.",
          "keyInnovation": "Multiple specialist studios and visual languages are combined inside a unified realtime-feeling world, with motion capture and graphic interfaces giving digital characters a performative presence."
        },
        "ja": {
          "shortSummary": "高密度な3DCG都市、飛行車両、仮面の人物、インターフェース・グラフィック、モーションキャプチャの演技が連続するサイバーパンクの追跡劇。",
          "whyItMatters": "日本のクリエイティブ・コレクティブが、アニメーション、CG、グラフィック、コンポジット、パフォーマンスキャプチャを一つの作家システムとして統括できることを示しました。",
          "historicalContext": "『攻殻機動隊 SAC_2045』との接続を持つ2020年の作品で、PERIMETRONの佐々木集と神戸雄平が監督し、多数の専門チームが参加しました。",
          "keyInnovation": "複数の専門スタジオと視覚言語を統一されたリアルタイム感のある世界へ結合し、モーションキャプチャとUI表現によってデジタルキャラクターへ演技の存在感を与えています。"
        }
      },
