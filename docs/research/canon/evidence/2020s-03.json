    {
      "artist": "Weval",
      "title": "Someday",
      "metadata": {
        "officialTitle": "Someday",
        "releaseYear": 2019,
        "countryCode": "IE",
        "directors": [
          "Páraic Mc Gloughlin"
        ],
        "productionCompany": null,
        "vfxProduction": null,
        "label": "Kompakt",
        "youtubeUrl": null,
        "youtubeId": null,
        "thumbnailUrl": null,
        "runtimeSeconds": null,
        "genre": "Electronic / Photographic Animation"
      },
      "editorial": {
        "en": {
          "shortSummary": "Thousands of photographs and moving images are sequenced by recurring shapes, directions, and gestures, producing an abstract journey through landscapes, bodies, and built environments.",
          "whyItMatters": "The video shows how visual continuity can be created without continuous action, using shared geometry across unrelated images as its primary editing logic.",
          "historicalContext": "Created by Irish filmmaker Páraic Mc Gloughlin for Weval and released in 2019 through Kompakt, Someday won Best Animation in a Video at the 2019 UK Music Video Awards.",
          "keyInnovation": "Photographic match cuts and frame-by-frame sequencing convert an archive of personal, public-domain, stock, and geographic imagery into fluid spatial motion."
        },
        "ja": {
          "shortSummary": "数千点の写真と映像を、反復する形、方向、身振りで連結し、風景、身体、建築空間を通過する抽象的な旅を作る作品。",
          "whyItMatters": "連続した動作を使わず、無関係な画像間の共通幾何を主要な編集論理として、視覚的連続性を構築できることを示しました。",
          "historicalContext": "アイルランドの映像作家Páraic Mc GloughlinがWevalのために制作し、Kompaktから2019年に公開。UK Music Video AwardsのBest Animation in a Videoを受賞しました。",
          "keyInnovation": "写真のマッチカットとフレーム単位の配列によって、個人写真、パブリックドメイン、ストック、地理画像のアーカイブを流動的な空間運動へ変換しています。"
        }
      },
