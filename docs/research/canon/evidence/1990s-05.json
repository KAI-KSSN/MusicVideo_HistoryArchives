      "artist": "Björk",
      "title": "Big Time Sensuality",
      "metadata": {
        "officialTitle": "Big Time Sensuality",
        "releaseYear": 1993,
        "countryCode": "IS",
        "directors": [
          "Stéphane Sednaoui"
        ],
        "productionCompany": null,
        "vfxProduction": null,
        "label": "One Little Indian",
        "youtubeUrl": "https://www.youtube.com/watch?v=75WFTHpOw8Y",
        "youtubeId": "75WFTHpOw8Y",
        "thumbnailUrl": "https://i.ytimg.com/vi/75WFTHpOw8Y/hqdefault.jpg",
        "runtimeSeconds": null,
        "genre": "Electronic Pop"
      },
      "editorial": {
        "en": {
          "shortSummary": "Björk dances and sings in black and white on the bed of a truck moving through New York, exposed to the city rather than isolated on a set.",
          "whyItMatters": "The video makes a single mobile performance sufficient, deriving energy from risk, traffic, changing background, and the artist's direct relation to the camera.",
          "historicalContext": "Released in 1993 during the Debut period and directed by Stéphane Sednaoui, the work presented the city as an active partner in an otherwise minimal performance film.",
          "keyInnovation": "A moving platform, frontal framing, uninterrupted urban variation, and spontaneous bodily response replace narrative construction with sustained presence."
        },
        "ja": {
          "shortSummary": "BjörkがNew Yorkを走るトラックの荷台で、セットに隔離されることなく、白黒映像の中で踊り歌う作品。",
          "whyItMatters": "ひとつの移動する演技だけで成立させ、危険、交通、変化する背景、カメラとの直接的な関係からエネルギーを引き出しました。",
          "historicalContext": "Stéphane Sednaouiの監督により1993年の『Debut』期に公開され、最小限のパフォーマンス映像の中で都市を能動的な共演者として提示しました。",
          "keyInnovation": "移動する足場、正面構図、途切れない都市の変化、即興的な身体反応によって、物語構築を持続する存在感へ置き換えています。"
        }
      },
