    {
      "artist": "Kylie Minogue",
      "title": "Come Into My World",
      "metadata": {
        "officialTitle": "Come Into My World",
        "releaseYear": 2002,
        "countryCode": null,
        "directors": [
          "Michel Gondry"
        ],
        "productionCompany": null,
        "vfxProduction": null,
        "label": null,
        "youtubeUrl": "https://www.youtube.com/watch?v=63vqob-MljQ",
        "youtubeId": "63vqob-MljQ",
        "thumbnailUrl": "https://i.ytimg.com/vi/63vqob-MljQ/maxresdefault.jpg",
        "runtimeSeconds": null,
        "genre": "Pop"
      },
      "editorial": {
        "en": {
          "shortSummary": "Kylie Minogue repeatedly circles a Paris street; with each completed loop, another Kylie and another copy of every surrounding action remain in the frame.",
          "whyItMatters": "The video turns repetition into visible accumulation, making a familiar urban block behave like a precisely timed system whose complexity grows while the camera's route stays constant.",
          "historicalContext": "Directed by Michel Gondry and released in 2002, the work belongs to a period in which large-scale compositing was used to extend practical choreography rather than replace it.",
          "keyInnovation": "A locked circular camera path, repeated performances, timed street action, and layered compositing multiply the entire environment while preserving the continuity of a single apparent take."
        },
        "ja": {
          "shortSummary": "Kylie Minogueがパリの街角を繰り返し一周し、周回を終えるたびに彼女自身と周囲のすべての行為の複製が画面内へ残っていく作品。",
          "whyItMatters": "反復を目に見える蓄積へ変え、カメラの経路を一定に保ちながら、見慣れた街区を複雑さが増殖する精密なシステムとして機能させました。",
          "historicalContext": "Michel Gondryが監督し2002年に公開。大規模な合成技術を、実演の振付に置き換えるのではなく拡張するために用いた時期の代表作です。",
          "keyInnovation": "固定された円形のカメラ軌道、反復する演技、時間設計された街路の動作、レイヤー合成によって、一見したワンカットの連続性を保ちながら環境全体を増殖させています。"
        }
      },
