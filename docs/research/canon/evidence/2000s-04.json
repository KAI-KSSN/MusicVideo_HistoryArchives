    {
      "artist": "宇多田ヒカル",
      "title": "Traveling",
      "metadata": {
        "officialTitle": "traveling",
        "releaseYear": 2001,
        "countryCode": "JP",
        "directors": [
          "紀里谷和明"
        ],
        "productionCompany": null,
        "vfxProduction": null,
        "label": "Toshiba-EMI",
        "youtubeUrl": "https://www.youtube.com/watch?v=tuyZ9f6mHZk",
        "youtubeId": "tuyZ9f6mHZk",
        "thumbnailUrl": "https://i.ytimg.com/vi/tuyZ9f6mHZk/maxresdefault.jpg",
        "runtimeSeconds": null,
        "genre": "J-Pop"
      },
      "editorial": {
        "en": {
          "shortSummary": "Utada moves through a brightly artificial journey of vehicles, tunnels, plant forms, miniature worlds, and stage machinery built as a continuous pop fantasy.",
          "whyItMatters": "The video treats production design as narrative motion, using color, constructed space, and visible artifice to turn travel into an elastic sequence of imagined environments.",
          "historicalContext": "Released as a DVD single in 2002 after the song's 2001 release, the work received the Japanese short-form Music Video of the Year award at the 17th Japan Gold Disc Awards.",
          "keyInnovation": "Miniatures, oversized props, mechanical scenery, saturated color fields, compositing, and abrupt changes of scale allow each space to transform into the next without requiring realistic continuity."
        },
        "ja": {
          "shortSummary": "宇多田ヒカルが、乗り物、トンネル、植物の形、ミニチュア世界、舞台機構が連なる鮮やかな人工の旅を進むポップ・ファンタジー。",
          "whyItMatters": "美術設計を物語の運動として扱い、色、構築された空間、人工性を隠さない表現によって、移動を伸縮自在な想像環境の連続へ変えました。",
          "historicalContext": "楽曲は2001年に公開され、映像は2002年にDVDシングルとして発売。第17回日本ゴールドディスク大賞で邦楽部門（短編）のミュージック・ビデオ・オブ・ザ・イヤーを受賞しました。",
          "keyInnovation": "ミニチュア、巨大な小道具、機械仕掛けの舞台、高彩度の色面、合成、急激なスケール変化によって、現実的な連続性に依存せず空間を次々と変形させています。"
        }
      },
