    {
      "artist": "サカナクション",
      "title": "アルクアラウンド",
      "metadata": {
        "officialTitle": "アルクアラウンド",
        "releaseYear": 2010,
        "countryCode": "JP",
        "directors": [
          "関和亮"
        ],
        "productionCompany": null,
        "vfxProduction": null,
        "label": "Victor Entertainment",
        "youtubeUrl": "https://www.youtube.com/watch?v=vS6wzjpCvec",
        "youtubeId": "vS6wzjpCvec",
        "thumbnailUrl": "https://i.ytimg.com/vi/vS6wzjpCvec/hqdefault.jpg",
        "runtimeSeconds": null,
        "genre": "Rock"
      },
      "editorial": {
        "en": {
          "shortSummary": "Ichiro Yamaguchi walks through a dark studio while fragmented lyric objects align with the camera and become readable at precisely timed viewpoints.",
          "whyItMatters": "The video makes typography a physical event rather than an overlay, joining the act of reading to camera movement, performance, and the passage of time.",
          "historicalContext": "Directed by Kazuaki Seki and released in 2010, the work received an Excellence Award in the Entertainment Division of the 14th Japan Media Arts Festival.",
          "keyInnovation": "A continuous moving shot, forced-perspective letterforms, flip animation, lighting cues, and practical scenic mechanisms synchronize visible language with the song without digital compositing."
        },
        "ja": {
          "shortSummary": "山口一郎が暗いスタジオを歩き、分解された歌詞のオブジェがカメラの視点と重なる瞬間に読める文字へ変わる作品。",
          "whyItMatters": "タイポグラフィを画面上の合成ではなく物理的な出来事に変え、読む行為をカメラ移動、演奏、時間の経過へ接続しました。",
          "historicalContext": "関和亮が監督し2010年に公開。第14回文化庁メディア芸術祭エンターテインメント部門で優秀賞を受賞しました。",
          "keyInnovation": "連続する移動撮影、強制遠近法の文字、フリップアニメーション、照明の合図、実物の舞台装置によって、デジタル合成を使わずに可視化された言葉と楽曲を同期しています。"
        }
      },
