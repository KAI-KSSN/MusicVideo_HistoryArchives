    {
      "artist": "Massive Attack",
      "title": "Teardrop",
      "metadata": {
        "officialTitle": "Teardrop",
        "releaseYear": 1998,
        "countryCode": "GB",
        "directors": [
          "Walter Stern"
        ],
        "productionCompany": "Academy Films",
        "vfxProduction": null,
        "label": "Virgin Records",
        "youtubeUrl": "https://www.youtube.com/watch?v=u7K72X4eo_s",
        "youtubeId": "u7K72X4eo_s",
        "thumbnailUrl": "https://i.ytimg.com/vi/u7K72X4eo_s/maxresdefault.jpg",
        "runtimeSeconds": 285,
        "genre": "Trip-Hop"
      },
      "editorial": {
        "en": {
          "shortSummary": "A fetus appears to sing from within the womb, its movements and facial articulation synchronized to the track inside an otherwise abstract dark space.",
          "whyItMatters": "The film turns a technically constructed prenatal image into a restrained performance, allowing vulnerability rather than spectacle to govern the effect.",
          "historicalContext": "Released in 1998 during the Mezzanine period and directed by Walter Stern, the video extended Massive Attack's collaboration with the director into a digitally mediated single-subject image.",
          "keyInnovation": "A sustained computer-generated fetal performance combines anatomical reference, lip synchronization, fluid motion, and controlled lighting without cutting away to the artist."
        },
        "ja": {
          "shortSummary": "胎児が子宮内から歌うように現れ、抽象的な暗い空間の中で身体と顔の動きが楽曲へ同期する作品。",
          "whyItMatters": "技術的に構築された胎内イメージを抑制された演技へ変え、スペクタクルではなく脆さに効果全体を支配させました。",
          "historicalContext": "Walter Sternの監督により1998年の『Mezzanine』期に公開され、Massive Attackと監督の協働を、デジタルで媒介された単一被写体の映像へ展開しました。",
          "keyInnovation": "解剖学的参照、リップシンク、流動的な動作、制御された照明を統合したCG胎児の演技を、アーティスト映像へ切り替えず持続させています。"
        }
      },
