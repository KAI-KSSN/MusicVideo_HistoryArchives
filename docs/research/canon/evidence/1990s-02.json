    {
      "artist": "Radiohead",
      "title": "Karma Police",
      "metadata": {
        "officialTitle": "Karma Police",
        "releaseYear": 1997,
        "countryCode": "GB",
        "directors": [
          "Jonathan Glazer"
        ],
        "productionCompany": "Academy Films",
        "vfxProduction": null,
        "label": "Parlophone",
        "youtubeUrl": "https://www.youtube.com/watch?v=1uYWYWPc9HU",
        "youtubeId": "1uYWYWPc9HU",
        "thumbnailUrl": "https://i.ytimg.com/vi/1uYWYWPc9HU/maxresdefault.jpg",
        "runtimeSeconds": null,
        "genre": "Alternative Rock"
      },
      "editorial": {
        "en": {
          "shortSummary": "A car follows a running man along an unlit road while Thom Yorke watches from the rear seat, until the pursuit reverses through fire.",
          "whyItMatters": "The film sustains dread with one spatial premise, withholding explanation and using the camera's position to implicate the viewer in the pursuit.",
          "historicalContext": "Released in 1997 during the OK Computer period, the video was directed by Jonathan Glazer and produced through Academy Films.",
          "keyInnovation": "Restricted illumination, long-duration tracking, off-screen threat, and a reversal of pursuer and pursued turn a simple road into a complete narrative mechanism."
        },
        "ja": {
          "shortSummary": "暗い道路で車が走る男を追い、Thom Yorkeが後部座席から見つめるなか、炎によって追跡の関係が反転する作品。",
          "whyItMatters": "ひとつの空間的前提だけで不安を持続させ、説明を保留し、カメラの位置によって観客を追跡へ巻き込みました。",
          "historicalContext": "1997年の『OK Computer』期に公開され、Jonathan Glazerが監督し、Academy Filmsを通じて制作されました。",
          "keyInnovation": "限定された照明、長い追跡撮影、画面外の脅威、追う者と追われる者の反転によって、単純な道路を完結した物語装置へ変えています。"
        }
      },
