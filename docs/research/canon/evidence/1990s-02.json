    {
      "artist": "The Prodigy",
      "title": "Smack My Bitch Up",
      "metadata": {
        "officialTitle": "Smack My Bitch Up",
        "releaseYear": 1997,
        "countryCode": "GB",
        "directors": [
          "Jonas Åkerlund"
        ],
        "productionCompany": null,
        "vfxProduction": null,
        "label": "XL Recordings",
        "youtubeUrl": "https://www.youtube.com/watch?v=xW17jtkjvvg",
        "youtubeId": "xW17jtkjvvg",
        "thumbnailUrl": "https://i.ytimg.com/vi/xW17jtkjvvg/maxresdefault.jpg",
        "runtimeSeconds": null,
        "genre": "Electronic"
      },
      "editorial": {
        "en": {
          "shortSummary": "A night of intoxication, violence, theft, and sex is presented almost entirely through the first-person viewpoint of an initially unidentified protagonist.",
          "whyItMatters": "The film uses point of view not as a brief effect but as an ethical and perceptual trap, forcing the viewer to occupy behavior before the final identity reveal.",
          "historicalContext": "Directed by Jonas Åkerlund and released in 1997, the video became inseparable from debates about broadcast restriction, violence, sexuality, and music-video censorship.",
          "keyInnovation": "A body-mounted subjective camera, altered-state movement, concealed identity, and a delayed mirror reveal make viewpoint itself the narrative structure."
        },
        "ja": {
          "shortSummary": "酩酊、暴力、盗難、性行為に至る一夜を、正体が伏せられた人物の一人称視点でほぼ全編描く作品。",
          "whyItMatters": "POVを短い効果ではなく倫理的・知覚的な罠として用い、最後の正体開示まで観客に行為者の位置を占めさせました。",
          "historicalContext": "Jonas Åkerlundが監督し1997年に公開され、放送制限、暴力、性表現、MV検閲をめぐる議論と切り離せない作品となりました。",
          "keyInnovation": "身体に取り付けた主観カメラ、酩酊状態の動き、隠された人物像、遅れて現れる鏡の開示によって、視点自体を物語構造へ変えています。"
        }
      },
