    {
      "artist": "Aphex Twin",
      "title": "Come to Daddy",
      "metadata": {
        "officialTitle": "Come To Daddy",
        "releaseYear": 1997,
        "countryCode": "GB",
        "directors": [
          "Chris Cunningham"
        ],
        "productionCompany": "Black Dog Films",
        "vfxProduction": null,
        "label": "Warp",
        "youtubeUrl": "https://www.youtube.com/watch?v=TZ827lkktYs",
        "youtubeId": "TZ827lkktYs",
        "thumbnailUrl": "https://i.ytimg.com/vi/TZ827lkktYs/sddefault.jpg",
        "runtimeSeconds": null,
        "genre": "Electronic"
      },
      "editorial": {
        "en": {
          "shortSummary": "Children bearing the artist's face swarm a housing estate and gather around a television-born creature whose scream overwhelms an elderly witness.",
          "whyItMatters": "The film brought body horror, social-realist location work, and electronic-music identity into a single image system without softening their antagonism.",
          "historicalContext": "Released by Warp in 1997 and directed by Chris Cunningham, the video established a recurring collaboration between electronic music and a distinctly physical form of digital-era horror.",
          "keyInnovation": "Face replacement, prosthetic character design, documentary-textured photography, rapid movement, and an extended close-range scream combine the familiar and synthetic."
        },
        "ja": {
          "shortSummary": "アーティストの顔を持つ子どもたちが集合住宅地を群れで走り、テレビから現れる怪物を囲み、その叫びが老女を圧倒する作品。",
          "whyItMatters": "ボディホラー、社会写実的なロケーション、電子音楽の人格をひとつの映像システムへ統合し、それぞれの対立性を弱めませんでした。",
          "historicalContext": "Chris Cunninghamの監督によりWarpから1997年に公開され、電子音楽と物質感の強いデジタル時代の恐怖表現を結ぶ継続的な文脈を確立しました。",
          "keyInnovation": "顔の置換、特殊造形、ドキュメンタリー調の撮影、急速な運動、至近距離で持続する叫びによって、日常と人工物を結合しています。"
        }
      },
