    {
      "artist": "Madonna",
      "title": "Frozen",
      "metadata": {
        "officialTitle": "Frozen",
        "releaseYear": 1998,
        "countryCode": "US",
        "directors": [
          "Chris Cunningham"
        ],
        "productionCompany": null,
        "vfxProduction": null,
        "label": "Warner Bros.",
        "youtubeUrl": "https://www.youtube.com/watch?v=XS088Opj9o0",
        "youtubeId": "XS088Opj9o0",
        "thumbnailUrl": "https://i.ytimg.com/vi/XS088Opj9o0/maxresdefault.jpg",
        "runtimeSeconds": null,
        "genre": "Pop"
      },
      "editorial": {
        "en": {
          "shortSummary": "Madonna performs alone in a desert as her body divides, folds into the ground, and transforms into birds and a black dog.",
          "whyItMatters": "The film uses effects to extend a single performance into a mutable figure whose identity remains coherent across human, animal, and landscape forms.",
          "historicalContext": "Released in 1998 and directed by Chris Cunningham, the work joined the Ray of Light period's electronic sound to an austere desert image.",
          "keyInnovation": "Motion-controlled repetition, digital duplication, morphing, silhouette, and fabric movement turn transformation into a continuous choreographic event."
        },
        "ja": {
          "shortSummary": "Madonnaが砂漠でひとり演じ、身体が分裂し、地面へ折り畳まれ、鳥や黒い犬へ変身する作品。",
          "whyItMatters": "特殊効果によって単独の演技を可変的な像へ拡張し、人間、動物、風景の形を横断しても人物の一貫性を保ちました。",
          "historicalContext": "Chris Cunninghamの監督により1998年に公開され、『Ray of Light』期の電子的な音響を禁欲的な砂漠のイメージへ結びました。",
          "keyInnovation": "モーションコントロールによる反復、デジタル複製、モーフィング、シルエット、布の運動によって、変身を連続する振付として構成しています。"
        }
      },
