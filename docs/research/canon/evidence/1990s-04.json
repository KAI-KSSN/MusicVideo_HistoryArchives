      "title": "Black Hole Sun",
      "metadata": {
        "officialTitle": "Black Hole Sun",
        "releaseYear": 1994,
        "countryCode": "US",
        "directors": [
          "Howard Greenhalgh"
        ],
        "productionCompany": null,
        "vfxProduction": null,
        "label": "A&M",
