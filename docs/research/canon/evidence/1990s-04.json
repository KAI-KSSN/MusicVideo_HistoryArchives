    {
      "artist": "Nine Inch Nails",
      "title": "Closer",
      "metadata": {
        "officialTitle": "Closer",
        "releaseYear": 1994,
        "countryCode": "US",
        "directors": [
          "Mark Romanek"
        ],
        "productionCompany": "Satellite Films",
        "vfxProduction": null,
        "label": "Nothing Records",
        "youtubeUrl": "https://www.youtube.com/watch?v=PTFwQP86BRs",
        "youtubeId": "PTFwQP86BRs",
        "thumbnailUrl": "https://i.ytimg.com/vi/PTFwQP86BRs/maxresdefault.jpg",
        "runtimeSeconds": 280,
        "genre": "Industrial Rock"
      },
      "editorial": {
        "en": {
          "shortSummary": "A sequence of distressed laboratory tableaux combines anatomical specimens, mechanical devices, religious symbols, animals, and Trent Reznor's suspended performance.",
          "whyItMatters": "The video made censorship visible within the work itself and treated the damaged broadcast image as part of its historical form rather than a neutral delivery problem.",
          "historicalContext": "Directed by Mark Romanek in 1994, the work circulated in edited broadcast versions while its uncensored form remained tied to home-video and later official releases.",
          "keyInnovation": "Hand-processed film texture, intermittent frames marked 'scene missing,' mechanical repetition, and museum-like tableaux fuse archival decay with controlled art direction."
        },
        "ja": {
          "shortSummary": "解剖標本、機械装置、宗教的象徴、動物、吊られたTrent Reznorの演技を、損傷した実験室のタブローとして連ねる作品。",
          "whyItMatters": "検閲を作品内部で可視化し、欠損した放送映像を単なる流通上の問題ではなく、作品の歴史的形態の一部として扱いました。",
          "historicalContext": "Mark Romanekの監督により1994年に制作され、編集された放送版が流通する一方、無修正版はホームビデオや後年の公式公開と結びつきました。",
          "keyInnovation": "手作業で処理されたフィルム質感、『scene missing』と記された断続フレーム、機械的反復、美術館的なタブローによって、アーカイブの劣化と精密な美術を融合しています。"
        }
      },
