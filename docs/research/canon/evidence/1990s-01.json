      "artist": "Jamiroquai",
      "title": "Virtual Insanity",
      "metadata": {
        "officialTitle": "Virtual Insanity",
        "releaseYear": 1996,
        "countryCode": "GB",
        "directors": [
          "Jonathan Glazer"
        ],
        "productionCompany": "Academy Films",
        "vfxProduction": null,
        "label": null,
        "youtubeUrl": "https://www.youtube.com/watch?v=4JkIs37a2JE",
        "youtubeId": "4JkIs37a2JE",
