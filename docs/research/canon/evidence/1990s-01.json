    {
      "artist": "Beastie Boys",
      "title": "Sabotage",
      "metadata": {
        "officialTitle": "Sabotage",
        "releaseYear": 1994,
        "countryCode": "US",
        "directors": [
          "Spike Jonze"
        ],
        "productionCompany": null,
        "vfxProduction": null,
        "label": "Grand Royal / Capitol Records",
        "youtubeUrl": "https://www.youtube.com/watch?v=z5rRZdiu1UE",
        "youtubeId": "z5rRZdiu1UE",
        "thumbnailUrl": "https://i.ytimg.com/vi/z5rRZdiu1UE/maxresdefault.jpg",
        "runtimeSeconds": null,
        "genre": "Hip-Hop / Rock"
      },
      "editorial": {
        "en": {
          "shortSummary": "The band performs fictional actors inside a compressed parody of 1970s police television, complete with chases, titles, stunts, and freeze-frame characterization.",
          "whyItMatters": "The film made parody inseparable from performance, showing that a music video could construct a complete fictional television object rather than merely reference a genre.",
          "historicalContext": "Released with Ill Communication in 1994 and directed by Spike Jonze, the video became a central example of the decade's low-budget, director-led alternative to polished studio spectacle.",
          "keyInnovation": "Handheld action, crash zooms, discontinuous cutting, character cards, and deliberately excessive acting reproduce the grammar of an imagined television series at song length."
        },
        "ja": {
          "shortSummary": "バンド自身が架空の俳優を演じ、追跡、タイトル、スタント、静止画による人物紹介を備えた1970年代刑事テレビの圧縮されたパロディを構成する作品。",
          "whyItMatters": "パロディと演奏を不可分にし、既存ジャンルを参照するだけでなく、架空のテレビ番組そのものをMVとして作れることを示しました。",
          "historicalContext": "Spike Jonzeの監督により1994年の『Ill Communication』期に公開され、洗練されたスタジオ型スペクタクルに対する、低予算で監督主導の1990年代的選択肢を代表しました。",
          "keyInnovation": "手持ちアクション、急なズーム、断続的な編集、人物カード、誇張された演技によって、架空テレビシリーズの文法を楽曲の長さへ再構成しています。"
        }
      },
