    {
      "artist": "Björk",
      "title": "All Is Full of Love",
      "metadata": {
        "officialTitle": "All Is Full of Love",
        "releaseYear": 1999,
        "countryCode": "GB",
        "directors": [
          "Chris Cunningham"
        ],
        "productionCompany": "RSA Films",
        "vfxProduction": null,
        "label": null,
        "youtubeUrl": "https://www.youtube.com/watch?v=cbGSy6PKOb0",
        "youtubeId": "cbGSy6PKOb0",
        "thumbnailUrl": "https://i.ytimg.com/vi/cbGSy6PKOb0/maxresdefault.jpg",
        "runtimeSeconds": 253,
        "genre": "Electronic / Art Pop"
      },
      "editorial": {
        "en": {
          "shortSummary": "Two white humanoid machines are assembled, observed, and drawn into an intimate encounter inside a bright clinical environment.",
          "whyItMatters": "The film treats robotics as a vehicle for tenderness and desire rather than technological display, making emotional ambiguity central to its effects work.",
          "historicalContext": "Directed by Chris Cunningham and released in 1999, the video accompanied the final single from Homogenic and entered museum, design, and music-video award contexts soon after release.",
          "keyInnovation": "Live-action performance, prosthetic shells, motion-controlled photography, and digital compositing merge human facial presence with manufactured bodies without resolving the boundary between them."
        },
        "ja": {
          "shortSummary": "白い人型機械二体が、明るい臨床的な空間で組み立てられ、観察され、親密な接触へ導かれる作品。",
          "whyItMatters": "ロボット技術を技術展示ではなく親密さと欲望の媒体として扱い、感情の曖昧さをVFX表現の中心に置きました。",
          "historicalContext": "Chris Cunninghamが監督し1999年に公開され、『Homogenic』最後のシングルに伴う映像として、美術館、デザイン賞、MV賞の文脈へ早くから入りました。",
          "keyInnovation": "実写演技、人工外装、モーションコントロール撮影、デジタル合成を統合し、人間の顔の存在感と製造された身体の境界を解消しないまま接続しています。"
        }
      },
