      "metadata": {
        "officialTitle": "Around The World",
        "releaseYear": 1997,
        "countryCode": "FR",
        "directors": [
          "Michel Gondry"
        ],
        "productionCompany": "Partizan",
        "vfxProduction": null,
        "label": null,
        "youtubeUrl": "https://www.youtube.com/watch?v=K0HSD_i2DvA",
        "youtubeId": "K0HSD_i2DvA",
        "thumbnailUrl": "https://i.ytimg.com/vi/K0HSD_i2DvA/maxresdefault.jpg",
        "runtimeSeconds": null,
        "genre": "Electronic"
      },
      "editorial": {
        "en": {
          "shortSummary": "Costumed performers translate separate parts of the track into a precisely organized choreographic system.",
          "whyItMatters": "Around the World demonstrates how musical structure itself can become the narrative and organizing principle of a music video.",
          "historicalContext": "Released in 1997 and directed by Michel Gondry, the video belongs to the director-driven music-video culture of the late 1990s.",
          "keyInnovation": "Distinct performer groups embody different musical components, turning repetition and arrangement into visible choreography."
        },
        "ja": {
          "shortSummary": "衣装をまとった複数のパフォーマーが、楽曲の各パートを精密な振付システムへ翻訳する作品。",
          "whyItMatters": "楽曲構造そのものを、MVの物語と構成原理へ変換できることを示した作品です。",
          "historicalContext": "1997年に公開され、Michel Gondryが監督した本作は、1990年代後半の監督主導型MV文化を代表しています。",
          "keyInnovation": "異なるパフォーマー群が別々の音楽要素を担当し、反復とアレンジを視覚的な振付として可視化しています。"
        }
      },
