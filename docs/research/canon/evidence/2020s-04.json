    {
      "artist": "A$AP Rocky",
      "title": "Tailor Swif",
      "officialVideoUnresolved": true,
      "metadata": {
        "officialTitle": "Tailor Swif",
        "releaseYear": 2024,
        "countryCode": "US",
        "directors": [
          "Vania Heymann",
          "Gal Muggia"
        ],
        "productionCompany": "Iconoclast",
        "vfxProduction": "Vania Heymann / Tal Baltuch",
        "label": "RCA / AWGE",
        "youtubeUrl": null,
        "youtubeId": null,
        "thumbnailUrl": null,
        "runtimeSeconds": null,
        "genre": "Hip-Hop / Surreal Narrative"
      },
      "editorial": {
        "en": {
          "shortSummary": "A chain of precisely staged urban tableaux turns ordinary streets into an escalating sequence of physical jokes, visual contradictions, and impossible transitions.",
          "whyItMatters": "The work extends the tradition of large-scale practical music-video spectacle while maintaining the concise timing and visual economy of a succession of single-shot ideas.",
          "historicalContext": "Directed by Vania Heymann and Gal Muggia, produced by Iconoclast, and released in 2024, the film received a CICLOPE Grand Prix, a Grammy nomination, and the SXSW Music Video Competition Audience Award.",
          "keyInnovation": "Each scene is designed as a self-contained visual proposition, but camera movement, match action, and controlled VFX connect the tableaux into a continuous rhythm of surprise."
        },
        "ja": {
          "shortSummary": "精密に演出された都市のタブローが連鎖し、日常の街路を身体的なジョーク、視覚的な矛盾、不可能な転換が拡大していく連続へ変える作品。",
          "whyItMatters": "大規模な実写スペクタクルというMVの伝統を継承しながら、一つずつ完結する視覚アイデアの簡潔なタイミングと経済性を保っています。",
          "historicalContext": "Vania HeymannとGal Muggiaが監督し、Iconoclastが制作した2024年の作品で、CICLOPE Grand Prix、Grammyノミネート、SXSW Music Video Competition Audience Awardを得ました。",
          "keyInnovation": "各場面を独立した視覚命題として設計しつつ、カメラ移動、動作の一致、制御されたVFXによって、驚きが連続する一つのリズムへ接続しています。"
        }
      },
