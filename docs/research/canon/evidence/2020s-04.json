    {
      "artist": "Pharrell Williams",
      "title": "Cash In Cash Out",
      "officialVideoUnresolved": true,
      "metadata": {
        "officialTitle": "Cash In Cash Out",
        "releaseYear": 2022,
        "countryCode": "US",
        "directors": [
          "François Rousselet"
        ],
        "productionCompany": "DIVISION",
        "vfxProduction": "Electric Theatre Collective",
        "label": "Columbia Records / Sony Music",
        "youtubeUrl": null,
        "youtubeId": null,
        "thumbnailUrl": null,
        "runtimeSeconds": null,
        "genre": "Hip-Hop / 3D Animation"
      },
      "editorial": {
        "en": {
          "shortSummary": "Three performers occupy a rotating zoetrope-like structure, where repeated figures and continuous camera motion turn a sculptural set into animated choreography.",
          "whyItMatters": "The video joins character animation, mechanical repetition, and performance direction in a single spatial idea rather than treating visual effects as a separate layer.",
          "historicalContext": "Directed by François Rousselet and produced by DIVISION with animation and visual-effects work by Electric Theatre Collective, the 2022 film became a major craft-award work across the following season.",
          "keyInnovation": "A virtual rotating apparatus is staged with the legibility of a physical optical toy, allowing loops, transformations, and multiple performers to share one continuous visual system."
        },
        "ja": {
          "shortSummary": "3人のパフォーマーが回転するゾートロープ状の構造に配置され、反復する人物像と連続的なカメラ運動が彫刻的なセットをアニメーション化する作品。",
          "whyItMatters": "キャラクターアニメーション、機械的な反復、パフォーマンス演出を一つの空間的アイデアへ統合し、VFXを独立した装飾層として扱わなかった点に意義があります。",
          "historicalContext": "François Rousseletが監督し、DIVISIONが制作、Electric Theatre CollectiveがアニメーションとVFXを担った2022年の作品で、翌年の主要なクラフト賞で評価されました。",
          "keyInnovation": "仮想的な回転装置を物理的な光学玩具のように明快に構成し、ループ、変形、複数のパフォーマーを一つの連続した視覚システムに収めています。"
        }
      },
