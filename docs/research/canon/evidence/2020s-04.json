    {
      "artist": "Bonobo",
      "title": "No Reason",
      "metadata": {
        "officialTitle": "No Reason",
        "releaseYear": 2017,
        "countryCode": "GB",
        "directors": [
          "Oscar Hudson"
        ],
        "productionCompany": "Pulse Films",
        "vfxProduction": null,
        "label": "Ninja Tune",
        "youtubeUrl": "https://www.youtube.com/watch?v=ebzEEEdjHj0",
        "youtubeId": "ebzEEEdjHj0",
        "thumbnailUrl": "https://i.ytimg.com/vi/ebzEEEdjHj0/maxresdefault.jpg",
        "runtimeSeconds": null,
        "genre": "Electronic / Conceptual"
      },
      "editorial": {
        "en": {
          "shortSummary": "A performer moves through a sequence of apparently identical rooms that become progressively smaller, turning domestic space into a controlled perceptual distortion.",
          "whyItMatters": "The film makes production design carry the central illusion, demonstrating how changes of scale can create an uncanny journey without relying on an explanatory narrative.",
          "historicalContext": "Oscar Hudson directed the 2017 video for Bonobo and Nick Murphy. It received the UK Music Video Awards for Best UK Dance Video and Best Production Design in a Video.",
          "keyInnovation": "Successive physical rooms, scaled props, matched framing, and choreographed movement create a continuous shrinking effect while preserving the tactile evidence of real sets."
        },
        "ja": {
          "shortSummary": "人物が同じように見える複数の部屋を進むたびに空間が段階的に縮小し、日常的な室内を精密な知覚の錯覚へ変える作品。",
          "whyItMatters": "プロダクションデザインそのものに錯覚の中心を担わせ、説明的な物語に依存せず、スケール変化だけで不穏な移動体験を作りました。",
          "historicalContext": "Oscar HudsonがBonoboとNick Murphyのために監督した2017年の作品で、UK Music Video AwardsのBest UK Dance VideoとBest Production Design in a Videoを受賞しました。",
          "keyInnovation": "段階的に縮小した実物セット、スケールの異なる小道具、対応する構図、振り付けられた移動を組み合わせ、物理的な手触りを保ったまま連続的な縮小効果を成立させています。"
        }
      },
