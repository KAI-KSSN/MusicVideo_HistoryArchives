      "artist": "The Clash",
      "title": "London Calling",
      "metadata": {
        "officialTitle": "London Calling",
        "releaseYear": 1979,
        "countryCode": "GB",
        "directors": [
          "Don Letts"
        ],
        "productionCompany": null,
