    {
      "artist": "The Chemical Brothers",
      "title": "Wide Open",
      "metadata": {
        "officialTitle": "Wide Open",
        "releaseYear": 2016,
        "countryCode": "GB",
        "directors": [
          "Dom & Nic"
        ],
        "productionCompany": "Outsider",
        "vfxProduction": "The Mill London",
        "label": "Virgin EMI",
        "youtubeUrl": "https://www.youtube.com/watch?v=BC2dRkm8ATU",
        "youtubeId": "BC2dRkm8ATU",
        "thumbnailUrl": "https://i.ytimg.com/vi/BC2dRkm8ATU/maxresdefault.jpg",
        "runtimeSeconds": null,
        "genre": "Electronic"
      },
      "editorial": {
        "en": {
          "shortSummary": "A dancer moves through an empty industrial space while her body is progressively replaced by a transparent, lattice-like digital structure.",
          "whyItMatters": "The video makes bodily transformation readable through uninterrupted choreography, allowing performance and visual effects to carry equal narrative weight.",
          "historicalContext": "Released in 2016, Wide Open was directed by Dom & Nic, produced by Outsider, and completed with visual effects by The Mill London for Virgin EMI.",
          "keyInnovation": "Detailed tracking, digital body replacement, and a continuous-feeling camera path preserve the dancer's movement while gradually exposing a synthetic internal structure."
        },
        "ja": {
          "shortSummary": "無人の工業空間で踊る身体が、透明な格子状のデジタル構造へ段階的に置き換わっていく作品。",
          "whyItMatters": "途切れない振付の中で身体変容を明瞭に読み取らせ、パフォーマンスとVFXに同等の物語的役割を与えました。",
          "historicalContext": "2016年に公開され、Dom & Nicが監督、Outsiderが制作、The Mill LondonがVFXを担当し、Virgin EMIから発表されました。",
          "keyInnovation": "精密なトラッキング、デジタル身体置換、連続して見えるカメラ動線によって、ダンサーの動きを保ちながら合成された内部構造を段階的に露出させています。"
        }
      },
