    {
      "artist": "Radiohead",
      "title": "Lift",
      "metadata": {
        "officialTitle": "Lift",
        "releaseYear": 2017,
        "countryCode": "GB",
        "directors": [],
        "productionCompany": null,
        "vfxProduction": null,
        "label": null,
        "youtubeUrl": "https://www.youtube.com/watch?v=QBGaO89cBMI",
        "youtubeId": "QBGaO89cBMI",
        "thumbnailUrl": "https://i.ytimg.com/vi/QBGaO89cBMI/maxresdefault.jpg",
        "runtimeSeconds": null,
        "genre": "Alternative Rock"
      },
      "editorial": {
        "en": {
          "shortSummary": "Thom Yorke rides through the shifting social space of a lift, encountering a succession of passengers and small incidents before the journey opens onto an unexpected domestic scene.",
          "whyItMatters": "The video uses an everyday vertical journey as a compact narrative container, allowing entrances, exits, repetition, and confined framing to accumulate meaning without explanatory dialogue.",
          "historicalContext": "Released in 2017 alongside the OK Computer OKNOTOK 1997 2017 reissue, the work gave a newly issued archival song a contemporary visual narrative.",
          "keyInnovation": "A constrained lift interior becomes a modular stage whose changing occupants and apparent continuity conceal transitions between social observation, memory, and dream logic."
        },
        "ja": {
          "shortSummary": "Thom Yorkeがエレベーター内を移動し、次々に乗り込む人物と小さな出来事を経て、予想外の家庭的空間へ到達する作品。",
          "whyItMatters": "日常的な上下移動を簡潔な物語容器として用い、出入り、反復、閉じたフレーミングだけで説明的台詞のない意味を蓄積しました。",
          "historicalContext": "2017年の『OK Computer OKNOTOK 1997 2017』再発に伴って公開され、新たに公式発表されたアーカイブ楽曲へ同時代の映像物語を与えました。",
          "keyInnovation": "制約されたエレベーター内部を可変的な舞台とし、乗客の交代と連続して見える移動の中に、社会観察、記憶、夢の論理を重ねています。"
        }
      },
