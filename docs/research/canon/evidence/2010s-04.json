      "editorial": {
        "en": {
          "shortSummary": "Hikaru Utada and KOHH occupy a dark, restrained performance space where faces, breath, and small bodily movements carry the work's emotional tension.",
          "whyItMatters": "The video removes spectacle from a high-profile collaboration and concentrates instead on two performers whose contrasting presence gives the song its visual structure.",
          "historicalContext": "Released in 2017 from the Fantôme period and directed by Kento Yamada, the work received the MTV VMAJ award for Best Collaboration Video.",
          "keyInnovation": "Minimal lighting and close observation reduce the image to voice, face, and gesture, allowing the collaboration itself to determine rhythm and spatial tension."
        },
        "ja": {
          "shortSummary": "宇多田ヒカルとKOHHが暗く抑制された空間に立ち、顔、呼吸、小さな身体動作が感情的緊張を担うパフォーマンス作品。",
          "whyItMatters": "注目度の高いコラボレーションからスペクタクルを取り除き、対照的な二人の存在そのものを楽曲の視覚構造へ集約しました。",
          "historicalContext": "『Fantôme』期の2017年に公開され、山田健人が監督。MTV VMAJのBest Collaboration Videoを受賞しました。",
          "keyInnovation": "最小限の照明と近接した観察によって映像を声、顔、身振りへ還元し、コラボレーションそのものにリズムと空間的緊張を決定させています。"
        }
      },
