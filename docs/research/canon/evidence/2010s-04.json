    {
      "artist": "OK Go",
      "title": "Needing / Getting",
      "metadata": {
        "officialTitle": "Needing/Getting",
        "releaseYear": 2012,
        "countryCode": "US",
        "directors": [
          "Brian L. Perkins"
        ],
        "productionCompany": "Caviar",
        "vfxProduction": null,
        "label": null,
        "youtubeUrl": "https://www.youtube.com/watch?v=MejbOFk7H6c",
        "youtubeId": "MejbOFk7H6c",
        "thumbnailUrl": "https://i.ytimg.com/vi/MejbOFk7H6c/maxresdefault.jpg",
        "runtimeSeconds": null,
        "genre": "Alternative Rock"
      },
      "editorial": {
        "en": {
          "shortSummary": "OK Go performs while a modified Chevrolet Sonic drives through a desert course, striking a large network of tuned objects and instruments in synchronization with the song.",
          "whyItMatters": "The work turns an automobile, a road, and an instrument field into one continuous performance system, making the production method visible as the central image.",
          "historicalContext": "Released in 2012 around a Super Bowl broadcast, the project adapted OK Go's established interest in single-system performances to a branded production built around a specially modified car.",
          "keyInnovation": "Robotic arms attached to the vehicle activate hundreds of tuned elements along the route, coordinating driving speed, physical impact, musical timing, and camera coverage within a practical environment."
        },
        "ja": {
          "shortSummary": "改造されたChevrolet Sonicで砂漠のコースを走行しながら、道路沿いに配置された多数の調律済みオブジェクトと楽器を楽曲に同期して鳴らす作品。",
          "whyItMatters": "自動車、道路、楽器群を一つの連続した演奏システムへ統合し、制作方法そのものを中心的な映像として可視化しました。",
          "historicalContext": "2012年のSuper Bowl放送に合わせて公開され、OK Goが継続してきた単一システム型のパフォーマンスを、特別改造車を中心とするブランド制作へ展開しました。",
          "keyInnovation": "車体に取り付けたロボットアームで走路上の多数の音響要素を作動させ、走行速度、物理的衝突、音楽的タイミング、撮影を実空間で同期しています。"
        }
      },
